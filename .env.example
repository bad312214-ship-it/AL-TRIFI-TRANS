# ===== TRIFI Cinema Studio — server-side configuration =====
# Copy to .env and fill in what you need. Everything works locally WITHOUT any key.

# --- App ---
APP_NAME=TRIFI Cinema Studio
APP_HOST=0.0.0.0
APP_PORT=8000
# Optional: protect /api/* with a bearer token (empty = open local studio)
APP_API_TOKEN=

# --- Screenplay LLM (any OpenAI-compatible endpoint: OpenAI, Groq, Ollama, LM Studio) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Images ---
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=

# --- Video ---
FAL_KEY=

# --- Text-to-Speech ---
ELEVENLABS_API_KEY=

# --- Default engines (local always works without keys) ---
DEFAULT_LLM_PROVIDER=local
DEFAULT_IMAGE_PROVIDER=local
DEFAULT_VIDEO_PROVIDER=local
DEFAULT_TTS_PROVIDER=local

# --- Job retry policy ---
JOB_MAX_ATTEMPTS=3
