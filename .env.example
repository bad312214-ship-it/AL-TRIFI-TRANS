# ============================================================
#  نظام أرض العيينة المحاسبي - ملف الإعدادات
#  انسخ هذا الملف إلى .env ثم عدّل القيم
# ============================================================

# منفذ الخادم
PORT=4000

# مسار قاعدة البيانات (نسبي من جذر المشروع)
DB_PATH=./data/oyaynah.db

# مجلد المرفقات
UPLOAD_DIR=./uploads

# بيئة التشغيل: production | demo
# في وضع demo يتم استخدام قاعدة بيانات منفصلة وواضحة الاسم
NODE_ENV=production

# مفتاح التشفير للجلسات (غيّره في الإنتاج)
SESSION_SECRET=change-me-in-production

# مدة صلاحية الجلسة بالساعات
SESSION_TTL_HOURS=12

# الحد الأقصى لحجم المرفق بالميجابايت
MAX_UPLOAD_MB=15

# اسم المستخدم الافتراضي لمدير النظام (يُنشأ عند أول تشغيل)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Oyaynah@2026
ADMIN_FULLNAME=مدير النظام
